@startuml
left to right direction

skinparam packageStyle rectangle
skinparam actorStyle awesome

actor "System Administrator" as SA
actor "Logistics Officer" as LO
actor "Dispatcher" as D
actor "Field Commander" as FC
actor "Field Crew Member" as FCM

rectangle "CrisisSync" {
  usecase "Authenticate User" as AU
  usecase "Manage Users" as MU
  usecase "Manage Permissions" as MP
  usecase "Load Data" as LD
  usecase "View Event History" as VEH
  usecase "Produce Management Logs" as PML

  usecase "Update Maintenance Status" as UMS
  usecase "Move Tools" as MT
  usecase "Update Staff Availability" as USA

  usecase "Monitor Live Event Status" as MLS
  usecase "Open Emergency Event" as OEE
  usecase "Define Task Tree" as DTT
  usecase "Close Emergency Event and Settle Costs" as CES

  usecase "Report Task Completion" as RTC
  usecase "Report Shift Start and Readiness" as RSS
  usecase "View Task Details" as VAT
  usecase "Report Equipment Malfunction" as REM
}

actor "External Billing System" as EBS

SA -- MU
SA -- MP
SA -- LD
SA -- VEH
SA -- PML
SA -- AU

LO -- UMS
LO -- MT
LO -- USA
LO -- AU

D -- MLS
D -- OEE
D -- DTT
D -- CES
D -- AU

FC -- MLS
FC -- RTC
FC -- VAT
FC -- REM
FC -- AU

FCM -- RSS
FCM -- VAT
FCM -- REM
FCM -- AU

EBS -- CES

MU ..> AU : <<include>>
MP ..> AU : <<include>>
LD ..> AU : <<include>>
VEH ..> AU : <<include>>
PML ..> AU : <<include>>
UMS ..> AU : <<include>>
MT ..> AU : <<include>>
USA ..> AU : <<include>>
MLS ..> AU : <<include>>
OEE ..> AU : <<include>>
DTT ..> AU : <<include>>
CES ..> AU : <<include>>
RTC ..> AU : <<include>>
RSS ..> AU : <<include>>
VAT ..> AU : <<include>>
REM ..> AU : <<include>>

@enduml
